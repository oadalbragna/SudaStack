{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sudastack",
  "compatibility_date": "2026-10-12",
  "main": "worker.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_RUNTIME",
        "class_name": "ProjectRuntime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectRuntime"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
